/* module-key = 'com.mgmtp.confluence.app.confluence-browse-people-permission:handle-field-parameter', location = 'js/handle-field-parameter.js' */
AJS.toInit(function () {
  AJS.MacroBrowser.setMacroJsOverride("secured-user-list", {
    beforeParamsRetrieved: function (params) {
      console.error("beforeParamsRetrieved-params");
      console.error(params);
      var groupsSelected = AJS.$(
        "#macro-param-div-mgm-group-name li.select2-search-choice"
      );
      var arrGroup = [];
      if (groupsSelected.length > 0) {
        groupsSelected.map((s, a) => {
          arrGroup.push(a.textContent.trim());
        });
      }
      params["mgm-group-name"] = JSON.stringify(arrGroup).toString();
      console.error(params);
      return params;
    },
  });
});

}catch(e){WRMCB(e)};
;
